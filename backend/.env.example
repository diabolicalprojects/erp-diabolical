# ─── DATABASE ────────────────────────────────────────────────────────────────
# MongoDB connection string (internal Dokploy network)
MONGODB_URI=mongodb://mongo:<PASSWORD>@<HOST>:27017

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# JWT secret key - use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend - ONLY this origin can call the API
FRONTEND_URL=https://erp.diabolicalservices.tech

# ─── WEBHOOKS SALIENTES (ERP → n8n, PRD §6) ──────────────────────────────────
# Destino por defecto. Se usa para cualquier evento sin URL propia.
# Déjalo vacío para desactivar el envío de webhooks.
N8N_WEBHOOK_URL=

# Destino por evento. Tiene prioridad sobre N8N_WEBHOOK_URL.
# Úsalos cuando cada evento tenga su propio workflow en n8n.
N8N_WEBHOOK_URL_QUOTE_SENT=https://n8n.diabolicalservices.tech/webhook/<uuid-del-workflow-Send-Quote>
N8N_WEBHOOK_URL_DEAL_CLOSED=https://n8n.diabolicalservices.tech/webhook/<uuid-del-workflow-de-cierre>

# Opcional: si lo defines, el ERP envía la cabecera `x-erp-secret` con este
# valor para que n8n pueda verificar el origen (nodo Webhook → Header Auth).
N8N_OUTBOUND_SECRET=

# ─── WEBHOOK DE ENTRADA (n8n → ERP) ──────────────────────────────────────────
# Secreto compartido que n8n debe enviar en la cabecera `x-webhook-secret` al
# llamar a POST /api/customers/webhook/n8n.
# OBLIGATORIO si usas ese webhook: sin él el endpoint responde 401.
# Genera uno con: openssl rand -hex 32
N8N_INBOUND_SECRET=

# ─── AUTENTICACIÓN (opcional) ────────────────────────────────────────────────
# Vigencia del JWT. Por defecto 7d.
JWT_EXPIRES_IN=7d

# ─── SEED (opcional) ─────────────────────────────────────────────────────────
# Credenciales del usuario admin inicial que crea `npm run seed`.
SEED_ADMIN_EMAIL=admin@diabolicalservices.tech
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Diabolical
