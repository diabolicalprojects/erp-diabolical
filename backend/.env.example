# ─── DATABASE ────────────────────────────────────────────────────────────────
# MongoDB connection string (internal Dokploy network)
MONGODB_URI=mongodb://mongo:<PASSWORD>@<HOST>:27017

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# JWT secret key - use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend - ONLY this origin can call the API
FRONTEND_URL=https://erp.diabolicalservices.tech
