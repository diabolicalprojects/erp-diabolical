# ─── DATABASE ────────────────────────────────────────────────────────────────
# MongoDB connection string (internal Dokploy network)
MONGODB_URI=mongodb://mongo:<PASSWORD>@<HOST>:27017

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# JWT secret key - use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend - ONLY this origin can call the API
FRONTEND_URL=https://erp.diabolicalservices.tech

# ─── n8n WEBHOOK (PRD §6 — WebhookDispatcher) ────────────────────────────────
# URL of your n8n flow webhook that receives deal.closed and other ERP events
# Leave empty to disable outbound webhook dispatch
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/erp-diabolical

# ─── WEBHOOK DE ENTRADA (n8n → ERP) ──────────────────────────────────────────
# Secreto compartido que n8n debe enviar en la cabecera `x-webhook-secret` al
# llamar a POST /api/customers/webhook/n8n.
# OBLIGATORIO si usas ese webhook: sin él el endpoint responde 401.
# Genera uno con: openssl rand -hex 32
N8N_INBOUND_SECRET=

# ─── AUTENTICACIÓN (opcional) ────────────────────────────────────────────────
# Vigencia del JWT. Por defecto 7d.
JWT_EXPIRES_IN=7d

# ─── SEED (opcional) ─────────────────────────────────────────────────────────
# Credenciales del usuario admin inicial que crea `npm run seed`.
SEED_ADMIN_EMAIL=admin@diabolicalservices.tech
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Diabolical
